# PCN-Pilot site configuration: the only file that changes between machines.
# Copy to <project>/pipeline.env or ~/.config/pcnpilot/pipeline.env and fill in.
# Plain KEY=VALUE lines; nothing here is executed.

# Interpreter that has PCNtoolkit 1.x installed (Python 3.11 or 3.12)
PCN_PYTHON=/path/to/conda/envs/pcntoolkit/bin/python

# Where models are fitted: local | slurm | torque
PCN_BACKEND=local

# --- cluster backends only -------------------------------------------------
# Path of the conda environment the jobs activate. Find it, with the env active, via:
#   python -c "import sys, os; print(os.path.dirname(os.path.dirname(sys.executable)))"
PCN_CONDA_ENV=
# Shell line run at the top of every job
PCN_PREAMBLE="module load anaconda3"
# Per-job resources
PCN_TIME_LIMIT="02:00:00"
PCN_MEMORY=8GB
PCN_N_CORES=1
# Number of jobs the response variables are spread over
PCN_N_BATCHES=10
# In-job retries (PCNtoolkit's own)
PCN_MAX_RETRIES=3
# Optional; exported as SBATCH_PARTITION / SBATCH_ACCOUNT / SBATCH_QOS
PCN_SLURM_PARTITION=
PCN_SLURM_ACCOUNT=
PCN_SLURM_QOS=

# --- QC dashboard ------------------------------------------------------------
PCN_QC_PORT=8765
